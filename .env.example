# Bible Arena — Environment Variables Template
PORT=3000
# Generate with: openssl rand -hex 32
COOKIE_SECRET=
SQLITE_PATH=./bible_arena_dev.sqlite
# Comma-separated browser origins. Do not use * in production.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000

# OAuth. Required for production OAuth deployments.
OAUTH_SERVER_URL=
OAUTH_STATE_SECRET=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Public web origin used by SEO canonical/Open Graph metadata
EXPO_PUBLIC_WEB_ORIGIN=https://your-production-domain.example

# Production operations
BACKUP_DIR=./backups
BACKUP_RETENTION=7
REALTIME_BACKPLANE=local
MAX_WS_CONNECTIONS_PER_IP=20
